---
import ImagePlaceholder from './ImagePlaceholder.astro';
import Icon from './Icon.astro';
import { url } from '../lib/url';
import type { ResearchTheme } from '../data/research';
interface Props { theme: ResearchTheme; index?: number }
const { theme, index = 0 } = Astro.props;
const tones = ['olive', 'sand', 'slate'] as const;
---
<article class="card research-card">
  <ImagePlaceholder label={theme.imageNote} ratio="16 / 10" tone={tones[index % 3]} seed={index + 1} />
  <div class="card__body">
    <h3><a href={url(`/research/#${theme.slug}`)}>{theme.title}</a></h3>
    <p>{theme.short}</p>
    <a class="text-link" href={url(`/research/#${theme.slug}`)}>Read more<span class="sr-only"> about {theme.title}</span> <Icon name="arrowRight" /></a>
  </div>
</article>

<style>
  .research-card h3 a { color: var(--slate); text-decoration: none; }
  .research-card .text-link { margin-top: auto; align-self: flex-start; }
</style>
