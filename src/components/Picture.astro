---
// Responsive image: WebP variants generated by scripts/optimize-images.mjs, original as fallback.
// `widths` must be variant widths that exist for this source (400, 640, 800, 1200; never above the source width).
import { url } from '../lib/url';
interface Props { src: string; alt: string; width: number; height: number; widths: number[]; sizes: string; loading?: 'lazy' | 'eager'; class?: string; style?: string }
const { src, alt, width, height, widths, sizes, loading = 'lazy', class: cls, style } = Astro.props;
const stem = src.replace(/\.(jpe?g|png)$/i, '');
const srcset = widths.map((w) => `${url(`${stem}-${w}.webp`)} ${w}w`).join(', ');
---
<picture>
  <source type="image/webp" srcset={srcset} sizes={sizes} />
  <img src={url(src)} alt={alt} width={width} height={height} loading={loading} decoding="async" class={cls} style={style} />
</picture>
