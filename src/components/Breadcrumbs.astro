---
import { url } from '../lib/url';
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
const all = [{ label: 'Home', href: '/' }, ...items];
---
<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    {all.map((item, i) => (
      <li>
        {item.href && i < all.length - 1 ? <a href={url(item.href)}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0; padding: 0; margin: 0 0 var(--space-4); font-family: var(--font-data); font-size: 0.78rem; letter-spacing: 0.04em; }
  .crumbs li + li::before { content: '/'; margin-inline: 0.6rem; opacity: 0.6; }
  .crumbs a { color: inherit; opacity: 0.85; }
  .crumbs a:hover { opacity: 1; color: inherit; }
</style>
