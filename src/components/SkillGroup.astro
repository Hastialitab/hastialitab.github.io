---
interface Props { title: string; items: { name: string; level?: string }[] }
const { title, items } = Astro.props;
---
<section class="skill-group">
  <h3>{title}</h3>
  <ul>
    {items.map((s) => (
      <li><span>{s.name}</span>{s.level && <span class="data-label">{s.level}</span>}</li>
    ))}
  </ul>
</section>

<style>
  .skill-group h3 { font-size: 1.1rem; padding-bottom: var(--space-2); border-bottom: 1px solid var(--line-strong); }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: flex; justify-content: space-between; gap: var(--space-4); padding: 0.4rem 0; border-bottom: 1px solid var(--line); font-size: 0.95rem; }
</style>
